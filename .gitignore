# Dependencies
node_modules/
.pnpm-store/

# Env / secrets
.env
.env.local
.env.*.local
# Backups of a secrets file are still a secrets file. `.env.local` is ignored
# but `.env.local.bak-*` was not, so a copy made before editing sat untracked
# and one `git add -A` away from being committed.
.env*.bak*
.env.local.*

# Build output
dist/
build/
*.tsbuildinfo

# ...except vendored Directus marketplace extensions. These are third-party
# BUILT bundles, not our build output: Directus loads `dist/index.js` at
# startup from the mounted ./directus/extensions volume, and nothing in this
# repo can regenerate them. The compensation request form needs super-header
# to render its action bar, so a fresh deploy without this file silently loses
# those buttons (docs/GO-LIVE-READINESS.md §4b).
!directus/extensions/*/dist/
!directus/extensions/*/dist/**

# Test / coverage
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
# Detached dev servers (PowerShell Start-Process) split stdout/stderr into
# <name>.log.out / <name>.log.err, which `*.log` does not match.
*.log.out
*.log.err

# Editor / OS
.DS_Store
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Directus / Postgres / Redis local volumes
directus/uploads/
directus/database/
.data/

# Local Directus SQLite dev instance
directus/local/data.db
directus/local/uploads/
directus/local/.directus/

# Local Redis dump
dump.rdb

# Local screenshot/critique artifacts (regenerated by scripts/shot-*.mjs)
.critique-shots/

# Third-party design references (vendored, not part of source)
.design-references/

# Editor / agent / IDE workspaces
.agents/
.idea/
.vscode/

# Claude Code session config (user-specific) — but DO ship project slash commands
# (e.g. /incident) so the server's Claude has them.
.claude/*
!.claude/commands/
!.claude/commands/**

# Spec-Kit tooling (local-only)
.specify/extensions/
.specify/integrations/
.specify/memory/
.specify/scripts/
.specify/workflows/

# Axe-core audit JSON output (regenerated by scripts/audit-a11y.mjs)
.audit-output/

# local dev runtime (native redis + directus run dir)
.redis-win/
.directus-run/

# Storybook build output
**/storybook-static
# Coverage helper + SQLite backups (from base)
coverage-buckets.mjs

.env.prod
.env.staging
.directus-prod/
.load-env.ps1
directus/local/data.db*

# Local dev artifacts (machine-specific helper + pg backup output dir)
backups/
dev-supervisor.ps1

# Bull Board tool runtime logs
tools/bull-board/bb.out
tools/bull-board/bb.err
tools/bull-board/package-lock.json
tools/load-test/package-lock.json
tools/screenshot/shots/
tools/screenshot/package-lock.json
tools/job-producer/jp.out
tools/job-producer/jp.err
tools/job-producer/package-lock.json

# Local ngrok tunnel config — tied to a personal ngrok account's reserved domain
ngrok-tunnels.yml

# Local production-rehearsal artifacts (machine-specific; the shared deploy is
# Docker-only). .env.prod.smoke also carries real shared secrets.
.env.prod.smoke
ecosystem.hybrid.config.cjs
deploy/nginx.local.conf
stream details.txt

# Incident-response runtime output (captured logs may contain sensitive data)
scripts/incident/reports/
var/

# The operations manager's own CRM and its live export, dropped in here as
# reference material. CONTAINS REAL CUSTOMER PII: Complaints_History_Import.csv
# holds 1,672 rows with real Saudi mobile numbers and complaint text, and
# users.json holds staff accounts. It sat untracked-but-not-ignored, one
# `git add -A` away from being published to GitHub.
Ayman/
.directus-test.env

# Rendered task definitions from scripts/deploy-service.sh — they carry the
# live environment values and must never be committed.
.taskdef-*.json
