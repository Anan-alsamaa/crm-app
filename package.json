{
  "name": "yiji-crm",
  "version": "0.0.0",
  "private": true,
  "description": "Yiji CRM — centralized internal customer support & CRM platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:advisories": "node scripts/check-advisories.mjs",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "guard:security-callsites": "node .github/scripts/check-security-callsites.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prepare": "husky || true",
    "test": "vitest run && pnpm -r --if-present test",
    "test:coverage": "vitest run --coverage",
    "test:coverage:apps": "pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "node tests/e2e-local/run.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:e2e": "node scripts/verify.mjs --e2e",
    "fix:agent-login": "node scripts/fix-agent-login.mjs",
    "guard:i18n": "node scripts/check-i18n-coverage.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.6",
    "axe-core": "^4.10.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9",
      "find-my-way@<=9.6.0": ">=9.7.0 <10",
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0 <3",
      "@opentelemetry/core@<2.8.0": ">=2.8.0 <3",
      "protobufjs@<7.6.5": ">=7.6.5 <8",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9 <6",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "postcss@<8.5.18": ">=8.5.18 <9",
      "vite@>=6.0.0 <6.4.3": ">=6.4.3 <7",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "react-router@>=7.0.0 <7.18.2": ">=7.18.2 <8",
      "socket.io-parser@>=4.0.0 <4.2.7": ">=4.2.7 <5"
    }
  }
}
