# ============================================================================
# Yiji CRM — environment configuration (copy to .env and fill in)
# ============================================================================
# NOTE: The DIRECTUS_ADMIN_* and DB_PASSWORD values below are WEAK and for LOCAL
# DEV ONLY. Production MUST override them with strong, unique credentials. The
# prod compose requires these vars (boot fails if unset) but does NOT check
# their strength — do not ship "123456"/"directus"/"admin". See docs/DEPLOYMENT.md.
# ----------------------------------------------------------------------------

# --- Docker Compose project identity ---
# Names the containers, network and DATA VOLUMES (<project>_postgres_data etc.).
# Compose derives it from the FOLDER NAME when unset, so a stack started from one
# directory becomes invisible to compose run from another — and `up` would then
# create a second stack on brand-new EMPTY volumes, which looks identical to
# losing the database. Pin it once per environment and never change it on a
# deployment that already holds data (renaming orphans the old volumes).
COMPOSE_PROJECT_NAME=yiji-crm

# --- Directus (system of record) ---
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=123456
# Generate with: openssl rand -hex 32
DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Internal URL the Node services use to reach Directus. In docker-compose this is
# the service name; in the hybrid deploy (PM2 services on the host) it is the
# Directus loopback publish — set DIRECTUS_INTERNAL_URL=http://127.0.0.1:8055.
DIRECTUS_INTERNAL_URL=http://directus:8055

# --- PostgreSQL ---
# Directus runs on Postgres in every environment (spec CLAUDE.md — non-negotiable;
# no SQLite). DB_HOST is `postgres` inside docker-compose; for a native local
# Postgres use `localhost` in your gitignored .env. See directus/local/.env.example.
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yiji_crm
DB_USER=directus
DB_PASSWORD=directus

# Host-side address of the SAME database, for tools that run outside the docker
# network — the bootstrap's raw-SQL constraints step is the only one today.
# DB_HOST/DB_PORT above are the CONTAINER's view (`postgres:5432`), which does
# not resolve from the host, so these exist as a separate pair; docker-compose
# publishes the container on 127.0.0.1:${DB_PORT_EXTERNAL}.
#
# 5434, not 5432/5433: a machine with a native PostgreSQL install already owns
# those. Pointing the bootstrap at one of them does not fail — it writes every
# index into the wrong database and reports success. (`apply` now refuses to run
# raw SQL unless the connection proves it is the database behind Directus.)
DB_HOST_EXTERNAL=localhost
DB_PORT_EXTERNAL=5434

# --- Redis (Socket.IO adapter + BullMQ + AI cache) ---
REDIS_URL=redis://redis:6379

# --- Customer (widget) auth ---
# HS256 shared secret for MVP; RS256 public key supported later via YIJI_JWT_PUBLIC_KEY.
YIJI_JWT_SECRET=replace-with-shared-secret
# YIJI_JWT_PUBLIC_KEY=

# --- Directus service-account static tokens (seeded at bootstrap) ---
SVC_GATEWAY_TOKEN=replace-with-gateway-token
SVC_WORKERS_TOKEN=replace-with-workers-token
SVC_AI_TOKEN=replace-with-ai-token

# --- Custom service ports ---
SOCKET_GATEWAY_PORT=8080
AI_GATEWAY_PORT=8081

# --- AI provider (Gemini, behind AIProvider interface) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email (SMTP, behind MailTransport interface) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Yiji Support <support@example.com>"

# --- Yiji platform integration (unset URL => mock client) ---
YIJI_API_URL=
# Yiji ADMIN API service credential (order status history). Server-side only.
YIJI_ADMIN_API_URL=
YIJI_ADMIN_EMAIL=
YIJI_ADMIN_PASSWORD=
YIJI_API_KEY=

# Where an APPROVED coupon is pushed. Blank = the push is disabled: the worker
# logs the payload it would have sent and the request stays `approved` rather
# than `assigned`, so no report ever claims Yiji holds a coupon it has not been
# told about. Confirm the payload field names against Yiji's spec before
# setting this — see yijiCouponPayload in services/workers.
YIJI_COUPON_URL=

# --- File storage ---
# Directus 11 names the ACTIVE location, then configures it: there is no
# STORAGE_DRIVER (an earlier value here said otherwise and was read by nothing —
# local happens to be the default, so the mistake was invisible). docker-compose
# sets the local pair; uncomment the S3 block and set STORAGE_LOCATIONS=s3 to
# switch. Attachments are the one thing that must never live in Postgres, and
# on an ephemeral filesystem such as ECS/Fargate `local` loses every upload on
# task replacement — see docs/PRODUCTION.md.
STORAGE_LOCATIONS=local
# STORAGE_LOCATIONS=s3
# STORAGE_S3_DRIVER=s3
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=

# --- Frontend (Vite) public vars ---
VITE_DIRECTUS_URL=http://localhost:8055
VITE_SOCKET_URL=http://localhost:8080
VITE_AI_GATEWAY_URL=http://localhost:8081
# Where the portals post BullMQ jobs (POST /jobs/*): the admin portal's
# "Import CSV" + "Run report now", and the agent portal's assignment
# notifications (POST /jobs/notify-assignment).
#   Dev:  the host-run producer (tools/job-producer) on :3031.
#   Prod: the socket-gateway HTTP base URL — it exposes the SAME authed routes
#         (services/socket-gateway/src/index.ts), so only this URL changes.
# Both portals always send the logged-in user's Directus token as a Bearer; the
# gateway verifies the role (Admin/Administrator for import+report, Agent and up
# for notify-assignment) and, for assignments, derives the recipient server-side.
VITE_JOB_PRODUCER_URL=http://localhost:3031
# Optional dev-only shared token (matches the host producer's PRODUCER_TOKEN).
# VITE_JOB_PRODUCER_TOKEN=

# --- Runtime mode ---
# Set NODE_ENV=production on the three Node services in prod. It activates the
# Zod env guards (strict CORS, no placeholder secrets, Redis required, SMTP
# required). See docs/PRODUCTION.md → "Configuration & env validation".
NODE_ENV=development
# Strict CORS allow-list for the Node services (comma-separated exact origins).
# `*` is rejected when NODE_ENV=production.
CORS_ORIGIN=*

# --- Observability (OpenTelemetry) ---
# Tracing is OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set. Point it at any
# OTLP/HTTP collector (e.g. http://otel-collector:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx
# Required for full ESM auto-instrumentation under tsx (set in prod compose):
# NODE_OPTIONS=--import @opentelemetry/instrumentation/hook.mjs

# --- Postgres backup scripts (scripts/backup-pg.sh / restore-pg.sh) ---
# BACKUP_DIR=./backups
# RETENTION_DAYS=7

# --- Inbound webhooks (socket-gateway POST /webhooks/yiji) ---
# HMAC-SHA256 secret shared with the Yiji platform. Empty => endpoint returns
# 503 (disabled), never an unauthenticated open door. Sender must send
# X-Yiji-Timestamp (unix sec) + X-Yiji-Signature: sha256=<hmac of "<ts>.<body>">.
YIJI_WEBHOOK_SECRET=
# Replay-protection window in seconds (default 300).
WEBHOOK_TOLERANCE_SEC=300

# --- Attachment validation (socket-gateway message:send) ---
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_MIME=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain

# --- Per-socket message rate limit (token bucket) ---
MSG_RATE_CAPACITY=20
MSG_RATE_REFILL_PER_SEC=5
