{
  "_comment": [
    "ECS Fargate task definition for Directus — Yiji CRM, us-east-2.",
    "",
    "Console: ECS > Task definitions > Create new revision > JSON, paste this.",
    "Replace <ACCOUNT_ID> and every CHANGE-ME before registering.",
    "",
    "SECRETS ARE PLAIN ENVIRONMENT VARS because this account has no Secrets Manager",
    "access. Understand the tradeoff: anyone with ECS read access can read them in",
    "the task definition, and EVERY revision keeps a copy forever. Acceptable for a",
    "dev database; before real customer data move DB_PASSWORD / KEY / SECRET /",
    "ADMIN_PASSWORD to SSM Parameter Store SecureString and reference them with a",
    "`secrets` block instead (Parameter Store is usually available when Secrets",
    "Manager is not).",
    "",
    "KEY and SECRET must stay STABLE FOREVER — changing them invalidates every",
    "session and token in existence.",
    "",
    "REDIS is the cluster-mode configuration endpoint. It works because the services",
    "now build a Cluster client for `clustercfg.*` hosts and hash-tag the BullMQ",
    "keyspace; see packages/shared-config/src/redis.ts. Directus itself uses it only",
    "for cache + the shared rate limiter.",
    "",
    "STORAGE is S3: a Fargate filesystem is ephemeral, so `local` would discard",
    "every uploaded attachment on each task replacement."
  ],
  "family": "yiji-crm-directus",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/yiji-crm-directus-task",
  "containerDefinitions": [
    {
      "name": "directus",
      "image": "directus/directus:11",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8055,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_CLIENT",
          "value": "pg"
        },
        {
          "name": "DB_HOST",
          "value": "test-yiji.ctqnuieahhb8.us-east-2.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_DATABASE",
          "value": "afcoCrm"
        },
        {
          "name": "DB_USER",
          "value": "Yijicrm"
        },
        {
          "name": "DB_SSL__REJECT_UNAUTHORIZED",
          "value": "false"
        },
        {
          "name": "PUBLIC_URL",
          "value": "https://api.CHANGE-ME.com"
        },
        {
          "name": "ADMIN_EMAIL",
          "value": "CHANGE-ME@example.com"
        },
        {
          "name": "WEBSOCKETS_ENABLED",
          "value": "true"
        },
        {
          "name": "CORS_ENABLED",
          "value": "true"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "https://app.CHANGE-ME.com,https://admin.CHANGE-ME.com"
        },
        {
          "name": "CORS_CREDENTIALS",
          "value": "true"
        },
        {
          "name": "REFRESH_TOKEN_COOKIE_SAME_SITE",
          "value": "lax"
        },
        {
          "name": "REFRESH_TOKEN_COOKIE_SECURE",
          "value": "true"
        },
        {
          "name": "STORAGE_LOCATIONS",
          "value": "s3"
        },
        {
          "name": "STORAGE_S3_DRIVER",
          "value": "s3"
        },
        {
          "name": "STORAGE_S3_BUCKET",
          "value": "yiji-crm-directus-uploads"
        },
        {
          "name": "STORAGE_S3_REGION",
          "value": "us-east-2"
        },
        {
          "name": "EMAIL_TRANSPORT",
          "value": "smtp"
        },
        {
          "name": "EMAIL_FROM",
          "value": "Yiji Support <support@CHANGE-ME.com>"
        },
        {
          "name": "EMAIL_SMTP_HOST",
          "value": "CHANGE-ME"
        },
        {
          "name": "EMAIL_SMTP_PORT",
          "value": "587"
        },
        {
          "name": "EMAIL_SMTP_SECURE",
          "value": "false"
        },
        {
          "name": "PASSWORD_RESET_URL_ALLOW_LIST",
          "value": "https://app.CHANGE-ME.com/reset-password,https://admin.CHANGE-ME.com/reset-password"
        },
        {
          "name": "RATE_LIMITER_ENABLED",
          "value": "true"
        },
        {
          "name": "CACHE_ENABLED",
          "value": "true"
        },
        {
          "name": "REDIS",
          "value": "redis://clustercfg.redis-yiji.6ea0wx.use2.cache.amazonaws.com:6379"
        },
        {
          "name": "RATE_LIMITER_STORE",
          "value": "redis"
        },
        {
          "name": "RATE_LIMITER_REDIS",
          "value": "redis://clustercfg.redis-yiji.6ea0wx.use2.cache.amazonaws.com:6379"
        },
        {
          "name": "CACHE_STORE",
          "value": "redis"
        },
        {
          "name": "CACHE_AUTO_PURGE",
          "value": "true"
        },
        {
          "name": "DB_PASSWORD",
          "value": "CHANGE-ME-db-password"
        },
        {
          "name": "KEY",
          "value": "CHANGE-ME-uuid-stable-forever"
        },
        {
          "name": "SECRET",
          "value": "CHANGE-ME-uuid-stable-forever"
        },
        {
          "name": "ADMIN_PASSWORD",
          "value": "CHANGE-ME-strong-admin-password"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8055/server/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/yiji-crm-directus",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "directus",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
