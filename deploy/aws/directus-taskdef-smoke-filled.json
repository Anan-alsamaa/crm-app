{
  "family": "yiji-crm-directus",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "directus",
      "image": "directus/directus:11",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8055,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_CLIENT",
          "value": "pg"
        },
        {
          "name": "DB_HOST",
          "value": "test-yiji.ctqnuieahhb8.us-east-2.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_DATABASE",
          "value": "afcoCrm"
        },
        {
          "name": "DB_USER",
          "value": "yijicrm"
        },
        {
          "name": "DB_SSL__REJECT_UNAUTHORIZED",
          "value": "false"
        },
        {
          "name": "PUBLIC_URL",
          "value": "http://directus-smoke.local"
        },
        {
          "name": "ADMIN_EMAIL",
          "value": "e.habibi@anan.sa"
        },
        {
          "name": "WEBSOCKETS_ENABLED",
          "value": "true"
        },
        {
          "name": "CORS_ENABLED",
          "value": "true"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "*"
        },
        {
          "name": "CORS_CREDENTIALS",
          "value": "true"
        },
        {
          "name": "REFRESH_TOKEN_COOKIE_SAME_SITE",
          "value": "lax"
        },
        {
          "name": "REFRESH_TOKEN_COOKIE_SECURE",
          "value": "false"
        },
        {
          "name": "STORAGE_LOCATIONS",
          "value": "local"
        },
        {
          "name": "EMAIL_TRANSPORT",
          "value": "smtp"
        },
        {
          "name": "EMAIL_FROM",
          "value": "Yiji Support <support@yiji.local>"
        },
        {
          "name": "EMAIL_SMTP_HOST",
          "value": "localhost"
        },
        {
          "name": "EMAIL_SMTP_PORT",
          "value": "587"
        },
        {
          "name": "EMAIL_SMTP_SECURE",
          "value": "false"
        },
        {
          "name": "PASSWORD_RESET_URL_ALLOW_LIST",
          "value": "http://directus-smoke.local/reset-password"
        },
        {
          "name": "RATE_LIMITER_ENABLED",
          "value": "false"
        },
        {
          "name": "CACHE_ENABLED",
          "value": "false"
        },
        {
          "name": "DB_PASSWORD",
          "value": "PASTE_YOUR_RDS_PASSWORD_HERE"
        },
        {
          "name": "KEY",
          "value": "9ce47e9f-f7ec-4c41-9dc4-881eae060b3f"
        },
        {
          "name": "SECRET",
          "value": "289cc1d2-8789-4d88-a731-994310332bea"
        },
        {
          "name": "ADMIN_PASSWORD",
          "value": "0uKQ6DIjiRdznnxUR56Aa1!"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8055/server/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
