{
  "family": "crm-{{ENV}}-directus",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/crm-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/crm-task-role-{{ENV}}",
  "containerDefinitions": [
    {
      "name": "directus",
      "image": "{{ACCOUNT_ID}}.dkr.ecr.{{REGION}}.amazonaws.com/crm/directus:{{IMAGE_TAG}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8055,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crm-{{ENV}}/directus",
          "awslogs-region": "{{REGION}}",
          "awslogs-stream-prefix": "directus"
        }
      },
      "environment": [
        {
          "name": "DB_CLIENT",
          "value": "pg"
        },
        {
          "name": "DB_HOST",
          "value": "test-yiji.ctqnuieahhb8.us-east-2.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_DATABASE",
          "value": "crm_{{ENV}}"
        },
        {
          "name": "DB_USER",
          "value": "yijicrm"
        },
        {
          "name": "DB_SSL__REJECT_UNAUTHORIZED",
          "value": "false"
        },
        {
          "name": "REDIS",
          "value": "redis://clustercfg.redis-yiji.6ea0wx.use2.cache.amazonaws.com:6379"
        },
        {
          "name": "CACHE_ENABLED",
          "value": "true"
        },
        {
          "name": "CACHE_STORE",
          "value": "redis"
        },
        {
          "name": "CACHE_AUTO_PURGE",
          "value": "true"
        },
        {
          "name": "RATE_LIMITER_ENABLED",
          "value": "true"
        },
        {
          "name": "RATE_LIMITER_STORE",
          "value": "redis"
        },
        {
          "name": "WEBSOCKETS_ENABLED",
          "value": "true"
        },
        {
          "name": "STORAGE_LOCATIONS",
          "value": "s3"
        },
        {
          "name": "STORAGE_S3_DRIVER",
          "value": "s3"
        },
        {
          "name": "STORAGE_S3_BUCKET",
          "value": "crm-{{ENV}}-uploads-408568863712"
        },
        {
          "name": "STORAGE_S3_REGION",
          "value": "{{REGION}}"
        },
        {
          "name": "PUBLIC_URL",
          "value": "{{API_URL}}"
        },
        {
          "name": "CORS_ENABLED",
          "value": "true"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "{{PORTAL_ORIGINS}}"
        },
        {
          "name": "CORS_CREDENTIALS",
          "value": "true"
        },
        {
          "name": "REFRESH_TOKEN_COOKIE_SAME_SITE",
          "value": "lax"
        },
        {
          "name": "REFRESH_TOKEN_COOKIE_SECURE",
          "value": "true"
        },
        {
          "name": "PASSWORD_RESET_URL_ALLOW_LIST",
          "value": "{{PORTAL_ORIGINS}}"
        },
        {
          "name": "EMAIL_TRANSPORT",
          "value": "smtp"
        },
        {
          "name": "EMAIL_SMTP_HOST",
          "value": "smtp.office365.com"
        },
        {
          "name": "EMAIL_SMTP_PORT",
          "value": "587"
        },
        {
          "name": "EMAIL_SMTP_SECURE",
          "value": "false"
        },
        {
          "name": "EMAIL_SMTP_USER",
          "value": "Yiji@anan.sa"
        },
        {
          "name": "EMAIL_FROM",
          "value": "Sara CRM <Yiji@anan.sa>"
        },
        {
          "name": "KEY",
          "value": "{{SECRET:DIRECTUS_KEY}}"
        },
        {
          "name": "SECRET",
          "value": "{{SECRET:DIRECTUS_SECRET}}"
        },
        {
          "name": "ADMIN_EMAIL",
          "value": "{{SECRET:DIRECTUS_ADMIN_EMAIL}}"
        },
        {
          "name": "ADMIN_PASSWORD",
          "value": "{{SECRET:DIRECTUS_ADMIN_PASSWORD}}"
        },
        {
          "name": "DB_PASSWORD",
          "value": "{{SECRET:DB_PASSWORD}}"
        },
        {
          "name": "EMAIL_SMTP_PASSWORD",
          "value": "{{SECRET:SMTP_PASSWORD}}"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8055/server/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
